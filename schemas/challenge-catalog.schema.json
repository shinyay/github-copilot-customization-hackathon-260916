{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shinyay/github-copilot-customization-hackathon/schemas/challenge-catalog.schema.json",
  "title": "Challenge Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeTemplate",
    "sourceBaseline",
    "authoringReference",
    "releasePlan",
    "challenges"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runtimeTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "minimumTemplateVersion",
        "versionMarker"
      ],
      "properties": {
        "repository": {
          "const": "shinyay/github-copilot-customization-runtime-template"
        },
        "minimumTemplateVersion": {
          "const": 1
        },
        "versionMarker": {
          "const": ".hackathon/template.json"
        }
      }
    },
    "sourceBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "fileCount",
        "treeSha256"
      ],
      "properties": {
        "repository": {
          "const": "shinyay/code-to-doc-workshop-260910"
        },
        "commit": {
          "const": "398d7d1982a1402bcdba00d6c3ded67d8d338787"
        },
        "fileCount": {
          "const": 515
        },
        "treeSha256": {
          "const": "c3cd74e0d65b1ae88a29a4392eb42f9d51ba2c671d111796aacc69fd9cc5b111"
        }
      }
    },
    "authoringReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "vendoredSourcePath"
      ],
      "properties": {
        "repository": {
          "const": "shinyay/github-copilot-customization-labs"
        },
        "vendoredSourcePath": {
          "const": "fixtures/tsubame-wholesale"
        }
      }
    },
    "releasePlan": {
      "description": "Maintainer publication/review order only, not participant prerequisites or current publication state.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waves",
        "reviewBetweenWaves",
        "participantPrerequisite"
      ],
      "properties": {
        "waves": {
          "const": [
            [
              "HC-002",
              "HC-003",
              "HC-004",
              "HC-005",
              "HC-008"
            ],
            [
              "HC-010",
              "HC-012",
              "HC-013",
              "HC-014",
              "HC-015"
            ],
            [
              "HC-016",
              "HC-017",
              "HC-018",
              "HC-019",
              "HC-020"
            ],
            [
              "HC-021",
              "HC-022",
              "HC-023",
              "HC-024",
              "HC-025"
            ],
            [
              "HC-026",
              "HC-027",
              "HC-028",
              "HC-029",
              "HC-031"
            ],
            [
              "HC-032",
              "HC-033",
              "HC-034",
              "HC-035",
              "HC-036"
            ],
            [
              "HC-037",
              "HC-038",
              "HC-039",
              "HC-040",
              "HC-041"
            ],
            [
              "HC-042",
              "HC-043",
              "HC-044",
              "HC-045"
            ]
          ]
        },
        "reviewBetweenWaves": {
          "const": true
        },
        "participantPrerequisite": {
          "const": false
        }
      }
    },
    "challenges": {
      "type": "array",
      "minItems": 45,
      "maxItems": 45,
      "items": {
        "$ref": "#/$defs/challenge"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "textList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "entitlements",
        "additionalApprovals"
      ],
      "properties": {
        "environment": {
          "$ref": "#/$defs/textList"
        },
        "entitlements": {
          "$ref": "#/$defs/textList"
        },
        "additionalApprovals": {
          "$ref": "#/$defs/textList"
        }
      }
    },
    "runtimeRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "status",
        "reason"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "status": {
          "enum": [
            "blocked",
            "not-checked"
          ]
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capability": {
                "enum": [
                  "cross-branch-handoff",
                  "tracked-vscode-settings"
                ]
              }
            },
            "required": [
              "capability"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            }
          }
        }
      ]
    },
    "optionalRoute": {
      "description": "Optional guide/readiness metadata only. No executable Pack, condition, grant, evidence or outcome contract.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "page",
        "required",
        "prerequisites",
        "runtimeRequirements",
        "liveStatus",
        "stopReasons"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "not": {
            "const": "core"
          }
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "page": {
          "type": "string",
          "maxLength": 320,
          "pattern": "^challenges/hc-[0-9]{3}/optional/[a-z][a-z0-9-]{0,31}\\.md$"
        },
        "required": {
          "const": false
        },
        "prerequisites": {
          "$ref": "#/$defs/prerequisites"
        },
        "runtimeRequirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/runtimeRequirement"
          }
        },
        "liveStatus": {
          "const": "live-unobserved"
        },
        "stopReasons": {
          "$ref": "#/$defs/textList",
          "minItems": 1
        }
      }
    },
    "sourceLab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ids",
        "repository",
        "pages"
      ],
      "properties": {
        "ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^LAB-[0-9]{2}$"
          }
        },
        "repository": {
          "const": "shinyay/github-copilot-customization-labs"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^docs/labs/lab-[0-9]{2}-.+\\.md$"
          }
        }
      }
    },
    "challenge": {
      "type": "object",
      "required": [
        "id",
        "title",
        "track",
        "status",
        "sourceLab"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HC-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "track": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "published"
          ]
        },
        "sourceLab": {
          "$ref": "#/$defs/sourceLab"
        },
        "sourceKind": {
          "enum": [
            "baseline",
            "synthetic"
          ]
        },
        "optionalRoutes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/optionalRoute"
          }
        },
        "sourcePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "challengeVersion": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": "string"
        },
        "pack": {
          "type": "string"
        },
        "feature": {
          "type": "string"
        },
        "support": {
          "type": "object",
          "required": [
            "primary",
            "fallback"
          ],
          "properties": {
            "primary": {
              "type": "string"
            },
            "fallback": {
              "type": "string"
            }
          }
        },
        "isolation": {
          "type": "object",
          "required": [
            "tier",
            "conditionStrategy"
          ],
          "properties": {
            "tier": {
              "enum": [
                "workspace",
                "repository",
                "organization"
              ]
            },
            "conditionStrategy": {
              "enum": [
                "single-workspace",
                "separate-workspace",
                "separate-repository"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "published"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "challengeVersion",
              "page",
              "pack",
              "feature",
              "support",
              "isolation",
              "sourcePaths",
              "sourceKind",
              "optionalRoutes"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "challengeVersion"
                  ]
                },
                {
                  "required": [
                    "page"
                  ]
                },
                {
                  "required": [
                    "pack"
                  ]
                },
                {
                  "required": [
                    "feature"
                  ]
                },
                {
                  "required": [
                    "support"
                  ]
                },
                {
                  "required": [
                    "isolation"
                  ]
                },
                {
                  "required": [
                    "sourcePaths"
                  ]
                },
                {
                  "required": [
                    "sourceKind"
                  ]
                },
                {
                  "required": [
                    "optionalRoutes"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "sourceKind": {
                "const": "baseline"
              }
            },
            "required": [
              "sourceKind"
            ]
          },
          "then": {
            "properties": {
              "sourcePaths": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sourceKind": {
                "const": "synthetic"
              }
            },
            "required": [
              "sourceKind"
            ]
          },
          "then": {
            "properties": {
              "sourcePaths": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
