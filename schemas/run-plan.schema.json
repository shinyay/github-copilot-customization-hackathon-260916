{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shinyay/github-copilot-customization-hackathon/schemas/run-plan.schema.json",
  "title": "Core Run Plan or Optional Guide Readiness v1",
  "oneOf": [
    {
      "$ref": "#/$defs/core"
    },
    {
      "$ref": "#/$defs/optionalGuide"
    }
  ],
  "$defs": {
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "challenge",
        "condition",
        "proposedRepositoryName",
        "template",
        "isolation",
        "filesToInject",
        "participantChanges",
        "runStateEvidence",
        "pathOwnership",
        "postCreateSettings",
        "expectedHubIssueMetadata",
        "cleanup"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "mode": {
          "const": "dry-run"
        },
        "challenge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "version"
          ],
          "properties": {
            "id": {
              "pattern": "^HC-[0-9]{3}$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "condition": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "proposedRepositoryName": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "maxLength": 100
        },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "minimumVersion",
            "versionMarker"
          ],
          "properties": {
            "repository": {
              "const": "shinyay/github-copilot-customization-runtime-template"
            },
            "minimumVersion": {
              "const": 1
            },
            "versionMarker": {
              "const": ".hackathon/template.json"
            }
          }
        },
        "isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tier",
            "conditionStrategy",
            "freshWorkspace",
            "freshConversation",
            "freshProfile",
            "freshRepository"
          ],
          "properties": {
            "tier": {
              "enum": [
                "workspace",
                "repository",
                "organization"
              ]
            },
            "conditionStrategy": {
              "enum": [
                "single-workspace",
                "separate-workspace",
                "separate-repository"
              ]
            },
            "freshWorkspace": {
              "type": "boolean"
            },
            "freshConversation": {
              "type": "boolean"
            },
            "freshProfile": {
              "type": "boolean"
            },
            "freshRepository": {
              "type": "boolean"
            }
          }
        },
        "filesToInject": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "destination",
              "ownership",
              "allowOverwrite"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "destination": {
                "pattern": "^\\.hackathon/challenge/.+\\.template$"
              },
              "ownership": {
                "const": "pack-applied"
              },
              "allowOverwrite": {
                "const": false
              }
            }
          }
        },
        "participantChanges": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedMutations",
            "allowedAdditions",
            "activeCustomizationsDefault"
          ],
          "properties": {
            "allowedMutations": {
              "type": "array"
            },
            "allowedAdditions": {
              "type": "array"
            },
            "activeCustomizationsDefault": {
              "const": "deny"
            }
          }
        },
        "runStateEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "conditions",
              "stage",
              "requiredHeadings"
            ],
            "properties": {
              "path": {
                "pattern": "^\\.hackathon/evidence/.+"
              },
              "stage": {
                "const": "submitted"
              }
            }
          }
        },
        "pathOwnership": {
          "const": [
            "baseline-owned",
            "template-owned",
            "run-state",
            "pack-applied",
            "participant-addition",
            "submission-bundle",
            "ignored",
            "violation"
          ]
        },
        "postCreateSettings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visibility",
            "defaultBranch",
            "existingDestinationPolicy",
            "remoteCreation"
          ],
          "properties": {
            "visibility": {
              "const": "private"
            },
            "defaultBranch": {
              "const": "main"
            },
            "existingDestinationPolicy": {
              "const": "deny"
            },
            "remoteCreation": {
              "const": "deferred"
            }
          }
        },
        "expectedHubIssueMetadata": {
          "type": "object",
          "required": [
            "challengeId",
            "condition",
            "conditionsCompared",
            "participantTeam",
            "runId",
            "runtimeRepositoryUrl",
            "pullRequestUrl",
            "outcome"
          ],
          "properties": {
            "challengeId": {
              "pattern": "^HC-[0-9]{3}$"
            },
            "condition": {
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            },
            "conditionsCompared": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              }
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "advisory",
            "checks"
          ],
          "properties": {
            "advisory": {
              "const": true
            },
            "checks": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "required",
                  "verification"
                ],
                "properties": {
                  "name": {
                    "enum": [
                      "verifyBaseline",
                      "exportSubmission",
                      "stopProcesses",
                      "archiveRepository"
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "verification": {
                    "enum": [
                      "pass",
                      "fail",
                      "blocked",
                      "not-observed"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "optionalGuide": {
      "description": "Non-executable guide output. not-checked is never a readiness claim; any blocked runtime requirement blocks the aggregate.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "challenge",
        "route",
        "prerequisites",
        "runtimeRequirements",
        "readiness",
        "liveStatus",
        "stopReasons"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "mode": {
          "const": "optional-guide"
        },
        "challenge": {
          "$ref": "#/$defs/core/properties/challenge"
        },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "page",
            "required"
          ],
          "properties": {
            "id": {
              "$ref": "challenge-catalog.schema.json#/$defs/optionalRoute/properties/id"
            },
            "title": {
              "$ref": "challenge-catalog.schema.json#/$defs/text"
            },
            "page": {
              "$ref": "challenge-catalog.schema.json#/$defs/optionalRoute/properties/page"
            },
            "required": {
              "const": false
            }
          }
        },
        "prerequisites": {
          "$ref": "challenge-catalog.schema.json#/$defs/prerequisites"
        },
        "runtimeRequirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "challenge-catalog.schema.json#/$defs/runtimeRequirement"
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "environment",
            "entitlements",
            "additionalApprovals",
            "runtimeCapabilities"
          ],
          "properties": {
            "status": {
              "enum": [
                "blocked",
                "not-checked"
              ]
            },
            "environment": {
              "const": "not-checked"
            },
            "entitlements": {
              "const": "not-checked"
            },
            "additionalApprovals": {
              "const": "not-checked"
            },
            "runtimeCapabilities": {
              "enum": [
                "blocked",
                "not-checked"
              ]
            }
          }
        },
        "liveStatus": {
          "const": "live-unobserved"
        },
        "stopReasons": {
          "$ref": "challenge-catalog.schema.json#/$defs/textList",
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "runtimeRequirements": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "blocked"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            },
            "required": [
              "runtimeRequirements"
            ]
          },
          "then": {
            "properties": {
              "readiness": {
                "properties": {
                  "status": {
                    "const": "blocked"
                  },
                  "runtimeCapabilities": {
                    "const": "blocked"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "readiness": {
                "properties": {
                  "status": {
                    "const": "not-checked"
                  },
                  "runtimeCapabilities": {
                    "const": "not-checked"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
