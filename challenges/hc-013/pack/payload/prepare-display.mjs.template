import { createHash } from "node:crypto";
import { lstat, open, readFile, realpath, unlink } from "node:fs/promises";
import path from "node:path";

export const POLICY_ID = "hc013-full-display-v1";
const REPOSITORY = "shinyay/code-to-doc-workshop-260910";
const COMMIT = "398d7d1982a1402bcdba00d6c3ded67d8d338787";
const IDS = ["B1", "B2", "B3", "P1", "P2", "P3"];
const PINS = [
  {
    id: "B1",
    sourcePath: "wholesale-batch/src/main/java/jp/co/tsubame/wholesale/batch/service/OrderImportService.java",
    sha256: "540035ef9797badbb049502462c9dfc23295dd7124f30d23e757f7ed5e97dde2",
    bytes: 5047, lineCount: 97,
    displaySha256: "540035ef9797badbb049502462c9dfc23295dd7124f30d23e757f7ed5e97dde2",
    displayBytes: 5047,
  },
  {
    id: "B2",
    sourcePath: "wholesale-batch/src/main/java/jp/co/tsubame/wholesale/batch/OrderGroup.java",
    sha256: "6fd51123ea20d737192c90ebe9d06bc9cd893e1f352ba31d036c00350237f986",
    bytes: 5408, lineCount: 126,
    displaySha256: "6fd51123ea20d737192c90ebe9d06bc9cd893e1f352ba31d036c00350237f986",
    displayBytes: 5408,
  },
  {
    id: "B3",
    sourcePath: "wholesale-batch/src/test/java/jp/co/tsubame/wholesale/batch/OrderImportPostgresTest.java",
    sha256: "4512773a9a39ba25e61b1c1b1d0d9150d8004bfe43fb94617fb1bbe1c4a2ee63",
    bytes: 27073, lineCount: 467,
    displaySha256: "a9db7fae855db85ce87d0fc2e83c69d6d6f1862fdc95b75669a17714a6eab32a",
    displayBytes: 27214,
  },
];
const INPUT_PINS = {
  "source-packet.json.template": "3f23d4a368843a1623cb34d51116ce92046c1b7ea07a8705cefd3e975fd30be4",
  "snapshot.json.template": "465e6be6eb084703f15759de02928ee365dfbbcad3d356253f9e9b19f26ac6ca",
  "provenance-packets.json.template": "941d6f2cc64cf07b2958b10cc3cc179f4308eb2243ab30805e82726dd05d9930",
  "context-card.json.template": "b877eea836165f2edce9aa83355f5814b13ac049e73c2fb018e06f71d8ed0b77",
  "request.txt.template": "1c962f412543a74a3d399aeb2b037271e4576edfda6c6998f53c951201a0938c",
};
const OUTPUTS = {
  baseline: ["source-handoff.md"],
  "context-card": ["context-card.json.template"],
  "manual-equivalent": ["context-card.json.template", "manual-input.txt"],
};
const LINE_SHAPES = new Map([
  [86, /^        admin = login\("[^"\\]*", "([^"\\]*)"\);$/u],
  [87, /^        manager = login\("[^"\\]*", "([^"\\]*)"\);$/u],
  [237, /^        Cli refused = cli\("[^"\\]*", "([^"\\]*)", "[^"\\]*", "[^"\\]*", input\.toString\(\), "[^"\\]*", key\(\)\);$/u],
  [242, /^        String password = "([^"\\]*)";$/u],
  [431, /^        return cli\("[^"\\]*", "([^"\\]*)", "[^"\\]*", "[^"\\]*", input\.toString\(\), "[^"\\]*", runKey\);$/u],
  [437, /^        return cli\("[^"\\]*", "([^"\\]*)", args\.toArray\(new String\[args\.size\(\)\]\)\);$/u],
]);
const digest = (bytes) => createHash("sha256").update(bytes).digest("hex");
const json = (value) => `${JSON.stringify(value, null, 2)}\n`;
const requireThat = (condition, code) => { if (!condition) throw new Error(code); };
const exactKeys = (value, keys) => value !== null && typeof value === "object" && !Array.isArray(value)
  && JSON.stringify(Object.keys(value).sort()) === JSON.stringify([...keys].sort());
const nonempty = (value) => typeof value === "string" && value.trim().length > 0;
const marker = (line) => `        // HC013_DISPLAY_REDACTED: authentication statement removed at original line ${line}; display only.`;

// Inspect only the pinned source. Removed values never leave this private function.
function inspectSource(id, input) {
  const pin = PINS.find((item) => item.id === id);
  requireThat(pin && Buffer.isBuffer(input), "HC013_SOURCE_ID");
  requireThat(input.length === pin.bytes && digest(input) === pin.sha256, `HC013_SOURCE_DRIFT_${id}`);
  const text = input.toString("utf8");
  const lines = text.split("\n");
  requireThat(Buffer.from(text).equals(input) && !input.includes(13)
    && lines.at(-1) === "" && lines.length - 1 === pin.lineCount, `HC013_SOURCE_SHAPE_${id}`);
  const removed = [];
  const redactedLines = id === "B3" ? [...LINE_SHAPES.keys()] : [];
  for (const number of redactedLines) {
    const match = LINE_SHAPES.get(number).exec(lines[number - 1]);
    requireThat(match && nonempty(match[1]), "HC013_STATEMENT_SHAPE");
    removed.push(match[1]);
  }
  if (removed.length > 0) {
    const occurrences = lines.flatMap((line, index) => removed.some((value) => line.includes(value)) ? [index + 1] : []);
    requireThat(JSON.stringify(occurrences) === JSON.stringify(redactedLines), "HC013_UNDECLARED_LITERAL_LOCATION");
  }
  const displayLines = [...lines];
  for (const number of redactedLines) displayLines[number - 1] = marker(number);
  const displayText = displayLines.join("\n");
  requireThat(removed.every((value) => !displayText.includes(value)), "HC013_REMOVED_LITERAL_REMAINED");
  const displayBytes = Buffer.from(displayText);
  requireThat(displayBytes.length === pin.displayBytes && digest(displayBytes) === pin.displaySha256, "HC013_DISPLAY_PIN");
  const original = {
    repository: REPOSITORY, revision: COMMIT, referenceType: "commit", sourcePath: pin.sourcePath,
    scope: "whole-file", sha256: pin.sha256, bytes: pin.bytes, lineCount: pin.lineCount,
  };
  const display = {
    policyId: POLICY_ID, scope: "whole-file-with-explicit-redactions",
    sha256: pin.displaySha256, bytes: pin.displayBytes, lineCount: pin.lineCount,
    originalByteExact: redactedLines.length === 0, redactedLines,
  };
  const transformation = {
    policyId: POLICY_ID,
    original,
    display,
    redactedLineCount: redactedLines.length,
    unchangedLineCount: pin.lineCount - redactedLines.length,
    spans: redactedLines.map((number) => ({
      startLine: number, endLine: number, operation: "replace-whole-line",
      reason: "test-authentication-statement", marker: marker(number),
    })),
    scopeNotice: "Full display with explicit omissions; not an executable-Java or original-byte-equivalence claim.",
  };
  return { result: { displayText, transformation }, removed };
}

export function transformSource(id, bytes) {
  return inspectSource(id, bytes).result;
}

export function parseDesign(bytes) {
  requireThat(Buffer.isBuffer(bytes) && !bytes.includes(13) && bytes.at(-1) === 10, "HC013_DESIGN_UTF8_LF");
  const text = bytes.toString("utf8");
  requireThat(Buffer.from(text).equals(bytes), "HC013_DESIGN_UTF8_LF");
  const blocks = [...text.matchAll(/^```hc013-design\n([\s\S]*?)^```[ \t]*$/gmu)];
  requireThat(blocks.length === 1, "HC013_DESIGN_BLOCK");
  let design;
  try { design = JSON.parse(blocks[0][1]); } catch { throw new Error("HC013_DESIGN_JSON"); }
  requireThat(exactKeys(design, ["instructions", "organization"]) && nonempty(design.instructions), "HC013_DESIGN_FIELDS");
  const organization = design.organization;
  requireThat(exactKeys(organization, ["reader", "readingOrder", "groups", "omissionPolicy"])
    && nonempty(organization.reader) && organization.omissionPolicy === "preserve-full-display-and-metadata",
  "HC013_ORGANIZATION_FIELDS");
  requireThat(Array.isArray(organization.readingOrder)
    && JSON.stringify([...organization.readingOrder].sort()) === JSON.stringify(IDS), "HC013_READING_ORDER");
  requireThat(Array.isArray(organization.groups) && organization.groups.length > 0
    && organization.groups.every((group) => exactKeys(group, ["title", "members"]) && nonempty(group.title)
      && Array.isArray(group.members) && group.members.length > 0
      && new Set(group.members).size === group.members.length && group.members.every((id) => IDS.includes(id))),
  "HC013_GROUPS");
  requireThat(new Set(organization.groups.flatMap((group) => group.members)).size === IDS.length, "HC013_GROUP_COVERAGE");
  return design;
}

async function regularFile(root, relative) {
  let current = await realpath(root);
  const parts = relative.split("/");
  requireThat(parts.every((part) => part && part !== "." && part !== ".." && !part.includes("\\")), "HC013_PATH");
  for (const [index, part] of parts.entries()) {
    current = path.join(current, part);
    const info = await lstat(current);
    requireThat(!info.isSymbolicLink() && (index === parts.length - 1 ? info.isFile() : info.isDirectory()), "HC013_REGULAR_FILE");
  }
  return current;
}

async function readRegular(root, relative) {
  return readFile(await regularFile(root, relative));
}

function renderHandoff(card) {
  const block = (value) => `\`\`\`json\n${json(value)}\`\`\`\n`;
  const { materials, ...envelope } = card;
  return Buffer.from([
    "# HC-013 Source handoff", "",
    "LOCAL_CONTEXT_CARD_NOT_A_COPILOT_SPACE / SYNTHETIC_TRAINING_ONLY",
    "SANITIZED_FULL_SOURCE_DISPLAY; original files remain read-only. This is not a Space response.", "",
    "## Instructions", "", block(card.instructions),
    "## Organization", "", block(envelope),
    "## Materials", "", ...materials.flatMap((material) => [`### ${material.id}`, "", block(material)]),
    "## Handoff and unknowns", "",
    "All six complete display materials and all metadata are retained. Original and display hashes have different meanings.",
    "Missing/error/empty/partial, unresolved main, NOT_PROVIDED history and Space/source access attributes are unchanged.", "",
    "## Non-claims", "",
    "The six declared B3 statements are replaced in full. Do not restore removed lines or values.",
    "This display may not be executable Java and is not an original-byte-exact copy.",
    "MCP, authentication, ACL, synchronization, runtimeBehavior and educationalEffect remain not-observed.",
    "This helper verifies prepared display integrity, not Runtime redaction, export acceptance or semantic correctness.", "",
  ].join("\n"));
}

export async function buildArtifacts(root, condition, { sourceRoot = root } = {}) {
  requireThat(Object.hasOwn(OUTPUTS, condition), "HC013_CONDITION");
  const designBytes = await readRegular(root, "participant/hc-013/design.md");
  const design = parseDesign(designBytes);
  const inputs = {};
  for (const [name, pin] of Object.entries(INPUT_PINS)) {
    const bytes = await readRegular(root, `.hackathon/challenge/hc-013/${name}`);
    requireThat(digest(bytes) === pin, `HC013_INPUT_PIN_${name}`);
    inputs[name] = bytes;
  }
  const packet = JSON.parse(inputs["source-packet.json.template"]);
  const inspected = [];
  for (const pin of PINS) {
    const bytes = await readRegular(sourceRoot, pin.sourcePath);
    inspected.push(inspectSource(pin.id, bytes));
  }
  const card = JSON.parse(inputs["context-card.json.template"]);
  card.instructions = design.instructions;
  card.organization = design.organization;
  card.observations.localSourceRead = "local-helper-original-pins-verified";
  card.preparation = {
    kind: "local-display-preparation", policyId: POLICY_ID,
    authoredDesignSha256: digest(designBytes), instructionsSha256: digest(Buffer.from(design.instructions)),
    requestSha256: digest(inputs["request.txt.template"]), sourceCount: 3, materialCount: 6,
    runtimeExport: "not-observed",
  };
  card.materials = PINS.map((pin, index) => {
    const result = inspected[index].result;
    const reference = packet.sourceReferences[index];
    requireThat(reference.id === pin.id && reference.sourcePath === pin.sourcePath && reference.revision === COMMIT
      && reference.referenceType === "commit" && reference.scope === "whole-file"
      && reference.originalSha256 === pin.sha256 && reference.originalBytes === pin.bytes
      && reference.originalLineCount === pin.lineCount
      && JSON.stringify(reference.display) === JSON.stringify(result.transformation.display), "HC013_SOURCE_METADATA");
    return { id: pin.id, sourcePath: pin.sourcePath, metadata: reference, ...result };
  });
  for (const [index, name] of ["source-packet.json.template", "snapshot.json.template", "provenance-packets.json.template"].entries()) {
    const bytes = inputs[name];
    card.materials.push({
      id: `P${index + 1}`, sourcePath: `.hackathon/challenge/hc-013/${name}`,
      metadata: {
        referenceType: "local-packet", revision: "hc013-materials-v2", scope: "whole-file",
        packetBytes: bytes.length, packetSha256: digest(bytes),
      },
      displayText: bytes.toString("utf8"),
    });
  }
  const cardBytes = Buffer.from(json(card));
  const generated = {
    "source-handoff.md": renderHandoff(card),
    "context-card.json.template": cardBytes,
    "manual-input.txt": Buffer.concat([Buffer.from(`${card.instructions}\n\n`), cardBytes]),
  };
  const artifacts = [
    { destination: "participant/hc-013/design.md", bytes: designBytes },
    ...OUTPUTS[condition].map((name) => ({ destination: `participant/hc-013/${name}`, bytes: generated[name] })),
  ];
  const removed = inspected.flatMap((item) => item.removed);
  requireThat(artifacts.every(({ bytes }) => removed.every((value) => !bytes.toString("utf8").includes(value))),
    "HC013_REMOVED_LITERAL_IN_ARTIFACT");
  return {
    condition, card, cardBytes, artifacts,
    sources: inspected.map(({ result }) => result.transformation),
    instructionsSha256: card.preparation.instructionsSha256,
  };
}

export function verifyPreparedArtifacts(prepared, actual) {
  requireThat(Array.isArray(actual) && JSON.stringify(actual.map((item) => item.destination))
    === JSON.stringify(prepared.artifacts.map((item) => item.destination)), "HC013_ARTIFACT_SET");
  for (const [index, artifact] of actual.entries()) {
    requireThat(Buffer.isBuffer(artifact.bytes) && artifact.bytes.equals(prepared.artifacts[index].bytes),
      `HC013_DISPLAY_ARTIFACT_MISMATCH_${path.posix.basename(artifact.destination)}`);
  }
}

async function createOnly(root, artifacts) {
  const created = [];
  try {
    for (const { destination } of artifacts) {
      const directory = path.posix.dirname(destination);
      await regularFile(root, `${directory}/design.md`);
      const target = path.join(await realpath(root), ...destination.split("/"));
      let exists = false;
      try { await lstat(target); exists = true; } catch (error) { if (error.code !== "ENOENT") throw error; }
      requireThat(!exists, "HC013_DESTINATION_EXISTS");
    }
    for (const artifact of artifacts) {
      const target = path.join(await realpath(root), ...artifact.destination.split("/"));
      const handle = await open(target, "wx");
      created.push({ target, handle, info: await handle.stat(), bytes: artifact.bytes });
    }
    for (const item of created) await item.handle.writeFile(item.bytes);
  } catch (error) {
    for (const item of created) {
      await item.handle.close();
      item.closed = true;
      let current;
      try {
        current = await lstat(item.target);
      } catch (cleanupError) {
        if (cleanupError.code !== "ENOENT") throw new Error("HC013_CLEANUP_IO_FAILURE", { cause: cleanupError });
      }
      if (current?.dev === item.info.dev && current?.ino === item.info.ino) await unlink(item.target);
    }
    throw error;
  } finally {
    for (const item of created) if (!item.closed) await item.handle.close();
  }
}

export async function runCli(args, root = process.cwd()) {
  requireThat((args.length === 2 || (args.length === 4 && args[2] === "--source-root" && path.isAbsolute(args[3])))
    && ["prepare", "verify"].includes(args[0]), "HC013_ARGUMENTS");
  const [operation, condition] = args;
  const prepared = await buildArtifacts(root, condition, { sourceRoot: args[3] ?? root });
  if (operation === "prepare") await createOnly(root, prepared.artifacts.slice(1));
  const actual = await Promise.all(prepared.artifacts.map(async ({ destination }) => ({
    destination, bytes: await readRegular(root, destination),
  })));
  verifyPreparedArtifacts(prepared, actual);
  return {
    challengeId: "HC-013", condition, operation, policyId: POLICY_ID,
    verification: "prepared-display-integrity-only", runtimeExport: "not-observed",
    instructionsSha256: prepared.instructionsSha256, cardSha256: digest(prepared.cardBytes),
    artifacts: actual.map(({ destination, bytes }) => ({ destination, bytes: bytes.length, sha256: digest(bytes) })),
    sources: prepared.sources,
  };
}

if (process.argv[1] === "-" && !import.meta.url.startsWith("data:")) {
  try {
    process.stdout.write(json(await runCli(process.argv.slice(2))));
  } catch (error) {
    const code = /^HC013_[A-Z0-9_.-]+$/iu.test(error.message) ? error.message
      : error.code === "EEXIST" ? "HC013_DESTINATION_EXISTS" : "HC013_PREPARATION_IO_FAILURE";
    process.stderr.write(`${code}\n`);
    process.exitCode = 1;
  }
}
