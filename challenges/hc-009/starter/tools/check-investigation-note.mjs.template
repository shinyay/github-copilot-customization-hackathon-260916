import { readFile } from "node:fs/promises";

const requiredHeadings = [
  "# CSV resend investigation note",
  "## Fixed task",
  "## Source map",
  "## New external_key",
  "## Matching payload hash",
  "## Different payload hash",
  "## canonicalHash",
  "## Skill observations",
  "## Unknowns and safety",
];

const filePath = process.argv[2];
if (!filePath) {
  console.error("Usage: node check-investigation-note.mjs <investigation-note.md>");
  process.exitCode = 2;
} else {
  const contents = await readFile(filePath, "utf8");
  const lines = new Set(
    contents.replace(/\r\n/gu, "\n").split("\n").map((line) => line.trimEnd()),
  );
  const missing = requiredHeadings.filter((heading) => !lines.has(heading));

  if (missing.length > 0) {
    for (const heading of missing) {
      console.error(`missing heading: ${heading}`);
    }
    process.exitCode = 1;
  } else {
    console.log(`Investigation note format: OK (${requiredHeadings.length} headings)`);
  }
}
