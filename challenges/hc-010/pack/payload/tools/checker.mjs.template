import { constants, closeSync, fstatSync, lstatSync, openSync, readSync, realpathSync } from 'node:fs';
import path from 'node:path';
import { decodeUtf8, isMain, isObject, LabError } from './hook-io.mjs';

export const LAB_PARTS = ['.runtime', 'independent-labs', 'lab-10'];
export const MAX_ACTIVE_BYTES = 1024;
export const MAX_DRAFT_BYTES = 64 * 1024;
export const REQUIRED_HEADINGS = ['## Evidence', '## Unknowns'];
export const RESULT_EXIT = Object.freeze({ pass: 0, invalid: 1, uncheckable: 2, skipped: 0 });
export const RESULT_CODES = Object.freeze({
  pass: ['OK'],
  invalid: ['MISSING_REQUIRED_HEADING', 'DUPLICATE_REQUIRED_HEADING', 'EMPTY_REQUIRED_SECTION', 'UNCLOSED_FENCE'],
  skipped: ['NO_ACTIVE_TARGET'],
  uncheckable: [
    'ACTIVE_TARGET_INVALID', 'ACTIVE_TARGET_TOO_LARGE', 'DRAFT_NOT_FOUND', 'DRAFT_TOO_LARGE',
    'UNSAFE_PATH', 'UNSAFE_FILE_TYPE', 'FILE_CHANGED_DURING_READ', 'FILE_READ_FAILED',
    'FILE_INVALID_UTF8', 'CHECKER_INTERNAL_ERROR', 'UNEXPECTED_ARGUMENTS'
  ]
});

export function report(result, code, missingHeadings = []) {
  return { protocolVersion: 1, lab: 'LAB-10', result, code, missingHeadings };
}

function readBoundedFile(workspace, parts, maxBytes, sizeCode) {
  const root = realpathSync(workspace);
  let current = root;
  let original;
  for (const [index, part] of parts.entries()) {
    current = path.join(current, part);
    original = lstatSync(current);
    if (original.isSymbolicLink()) throw new LabError('UNSAFE_PATH');
    const last = index === parts.length - 1;
    if (last ? !original.isFile() || original.nlink !== 1 : !original.isDirectory()) {
      throw new LabError('UNSAFE_FILE_TYPE');
    }
  }
  const relative = path.relative(root, realpathSync(current));
  if (!relative || relative === '..' || relative.startsWith(`..${path.sep}`) || path.isAbsolute(relative)) {
    throw new LabError('UNSAFE_PATH');
  }
  if (original.size > maxBytes) throw new LabError(sizeCode);
  const fd = openSync(current, constants.O_RDONLY | (constants.O_NOFOLLOW ?? 0));
  try {
    const opened = fstatSync(fd);
    if (!opened.isFile() || opened.nlink !== 1) throw new LabError('UNSAFE_FILE_TYPE');
    // Windows lstat can report dev=0 while fstat reports the actual volume ID.
    const differentDevice = opened.dev !== original.dev && !(process.platform === 'win32' && original.dev === 0);
    if (differentDevice || opened.ino !== original.ino) throw new LabError('FILE_CHANGED_DURING_READ');
    if (opened.size > maxBytes) throw new LabError(sizeCode);
    const bytes = Buffer.alloc(maxBytes + 1);
    let length = 0;
    while (length < bytes.length) {
      const count = readSync(fd, bytes, length, bytes.length - length, null);
      if (count === 0) break;
      length += count;
    }
    if (length > maxBytes) throw new LabError(sizeCode);
    const after = fstatSync(fd);
    if (after.size !== opened.size || after.mtimeMs !== opened.mtimeMs || after.ctimeMs !== opened.ctimeMs) {
      throw new LabError('FILE_CHANGED_DURING_READ');
    }
    return decodeUtf8(bytes.subarray(0, length), 'FILE_INVALID_UTF8');
  } finally {
    closeSync(fd);
  }
}

export function inspectDraft(text) {
  const sections = new Map(REQUIRED_HEADINGS.map(heading => [heading, { count: 0, hasBody: false }]));
  let fence = null;
  let section = null;
  for (const line of text.replace(/\r\n?/g, '\n').split('\n')) {
    if (fence) {
      if (new RegExp(`^ {0,3}${fence.character}{${fence.length},}[ \\t]*$`).test(line)) fence = null;
      continue;
    }
    const opening = /^ {0,3}(`{3,}|~{3,})(.*)$/.exec(line);
    if (opening) {
      fence = { character: opening[1][0], length: opening[1].length };
      continue;
    }
    if (/^ {0,3}#{1,6}[ \t]+/.test(line)) {
      section = sections.get(line.trim()) ?? null;
      if (section) section.count += 1;
    } else if (section && line.trim()) {
      section.hasBody = true;
    }
  }
  const missing = REQUIRED_HEADINGS.filter(heading => sections.get(heading).count === 0);
  if (missing.length) return report('invalid', 'MISSING_REQUIRED_HEADING', missing);
  if (fence) return report('invalid', 'UNCLOSED_FENCE');
  if ([...sections.values()].some(value => value.count !== 1)) return report('invalid', 'DUPLICATE_REQUIRED_HEADING');
  if ([...sections.values()].some(value => !value.hasBody)) return report('invalid', 'EMPTY_REQUIRED_SECTION');
  return report('pass', 'OK');
}

export function runCheck(workspace = process.cwd()) {
  try {
    const root = realpathSync(workspace);
    let activeText;
    try {
      activeText = readBoundedFile(root, [...LAB_PARTS, 'active.json'], MAX_ACTIVE_BYTES, 'ACTIVE_TARGET_TOO_LARGE');
    } catch (error) {
      if (error.code === 'ENOENT') return report('skipped', 'NO_ACTIVE_TARGET');
      throw error;
    }
    let active;
    try {
      active = JSON.parse(activeText);
    } catch {
      throw new LabError('ACTIVE_TARGET_INVALID');
    }
    if (!isObject(active) || Object.keys(active).sort().join(',') !== 'lab,runId' ||
      active.lab !== 'LAB-10' || typeof active.runId !== 'string' || !/^[a-z][a-z0-9-]{0,31}$/.test(active.runId)) {
      throw new LabError('ACTIVE_TARGET_INVALID');
    }
    let draft;
    try {
      draft = readBoundedFile(root, [...LAB_PARTS, active.runId, 'draft.md'], MAX_DRAFT_BYTES, 'DRAFT_TOO_LARGE');
    } catch (error) {
      if (error.code === 'ENOENT') return report('uncheckable', 'DRAFT_NOT_FOUND');
      throw error;
    }
    return inspectDraft(draft);
  } catch (error) {
    return report('uncheckable', error instanceof LabError ? error.code :
      typeof error.code === 'string' ? 'FILE_READ_FAILED' : 'CHECKER_INTERNAL_ERROR');
  }
}

if (isMain(import.meta.url)) {
  const result = process.argv.length === 2 ? runCheck() : report('uncheckable', 'UNEXPECTED_ARGUMENTS');
  process.stdout.write(`${JSON.stringify(result)}\n`);
  process.exitCode = RESULT_EXIT[result.result];
}
