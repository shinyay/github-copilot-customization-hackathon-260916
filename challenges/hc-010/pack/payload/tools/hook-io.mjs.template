import path from 'node:path';
import { pathToFileURL } from 'node:url';

export const MAX_INPUT_BYTES = 32 * 1024;

export class LabError extends Error {
  constructor(code) {
    super(code);
    this.code = code;
  }
}

export function isObject(value) {
  return value !== null && typeof value === 'object' && !Array.isArray(value);
}

export function isMain(url) {
  return Boolean(process.argv[1]) && pathToFileURL(path.resolve(process.argv[1])).href === url;
}

export function decodeUtf8(bytes, code) {
  try {
    return new TextDecoder('utf-8', { fatal: true }).decode(bytes);
  } catch {
    throw new LabError(code);
  }
}

export function readHookInput(stream = process.stdin, timeoutMs = 2000) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    let length = 0;
    const cleanup = () => {
      clearTimeout(timer);
      stream.off('data', onData);
      stream.off('end', onEnd);
      stream.off('error', onError);
    };
    const fail = code => {
      cleanup();
      stream.destroy();
      reject(new LabError(code));
    };
    const onData = chunk => {
      const bytes = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);
      length += bytes.length;
      if (length > MAX_INPUT_BYTES) return fail('HOOK_INPUT_TOO_LARGE');
      chunks.push(bytes);
    };
    const onError = () => fail('HOOK_INPUT_READ_FAILED');
    const onEnd = () => {
      cleanup();
      try {
        const text = decodeUtf8(Buffer.concat(chunks), 'HOOK_INPUT_INVALID_UTF8');
        let input;
        try {
          input = JSON.parse(text);
        } catch {
          throw new LabError('HOOK_INPUT_INVALID_JSON');
        }
        if (!isObject(input)) throw new LabError('HOOK_INPUT_NOT_OBJECT');
        resolve(input);
      } catch (error) {
        reject(error);
      }
    };
    const timer = setTimeout(() => fail('HOOK_INPUT_TIMEOUT'), timeoutMs);
    stream.on('data', onData);
    stream.once('end', onEnd);
    stream.once('error', onError);
  });
}

export function inputFailure(error) {
  return {
    continue: true,
    systemMessage: `[LAB-10] uncheckable: ${error instanceof LabError ? error.code : 'HOOK_INTERNAL_ERROR'}. No check or tool approval was performed.`
  };
}

export function writeHookOutput(output) {
  process.stdout.write(`${JSON.stringify(output)}\n`);
}
