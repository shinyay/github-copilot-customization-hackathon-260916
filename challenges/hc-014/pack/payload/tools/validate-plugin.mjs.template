import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { readFileSync, readdirSync } from 'node:fs';
import { basename, join, resolve } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

export const pluginSchema = 'https://agent-plugins.org/schemas/1.0.0/plugin.schema.json';
export const templatePluginRoot = fileURLToPath(new URL('./plugin/', import.meta.url));

function entries(directory) {
  const values = readdirSync(directory, { withFileTypes: true });
  assert(values.every(value => value.isFile() || value.isDirectory()), 'Symlinks and special files are outside this workshop subset');
  return values;
}

export function validateWorkshopPlugin(directory, { templates = true } = {}) {
  const suffix = templates ? '.template' : '';
  const root = entries(directory);
  assert.deepEqual(root.map(entry => entry.name).sort(), [`plugin.json${suffix}`, 'skills']);
  assert(root.find(entry => entry.name === `plugin.json${suffix}`).isFile());
  assert(root.find(entry => entry.name === 'skills').isDirectory());
  const manifest = JSON.parse(readFileSync(join(directory, `plugin.json${suffix}`), 'utf8'));
  assert.equal(manifest.$schema, pluginSchema, 'Only Agent Plugins 1.0 is supported by this workshop validator');
  assert.deepEqual(Object.keys(manifest).sort(), ['$schema', 'description', 'name', 'version']);
  assert.equal(typeof manifest.name, 'string');
  assert(manifest.name.length <= 64 && /^(?!.*(?:--|\.\.))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$/.test(manifest.name));
  assert.equal(typeof manifest.version, 'string');
  assert(manifest.version.length > 0);
  assert.equal(typeof manifest.description, 'string');
  const skills = entries(join(directory, 'skills'));
  assert.equal(skills.length, 1, 'Exactly one skill; no cumulative bundle');
  assert(skills[0].isDirectory());
  const skillDirectory = join(directory, 'skills', skills[0].name);
  const skillEntries = entries(skillDirectory);
  assert.deepEqual(skillEntries.map(entry => entry.name), [`SKILL.md${suffix}`]);
  assert(skillEntries[0].isFile());
  const bytes = readFileSync(join(skillDirectory, `SKILL.md${suffix}`));
  const skill = bytes.toString('utf8');
  assert(!skill.includes('\r'), 'Workshop skill files must use LF, as required by .gitattributes');
  // Deliberately validate only the two-field, single-line frontmatter this fixture uses.
  const frontmatter = skill.match(/^---\nname: ([^\n]+)\ndescription: ([^\n]+)\n---\n([\s\S]+)$/);
  assert(frontmatter, 'Expected the workshop name/description frontmatter, not arbitrary YAML');
  assert.equal(frontmatter[1], basename(skillDirectory));
  assert(frontmatter[1].length <= 64 && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(frontmatter[1]));
  assert(frontmatter[2].length > 0 && frontmatter[2].length <= 1024);
  assert(frontmatter[3].includes('未確認'));
  return {
    format: 'Agent Plugins 1.0 (workshop subset; not full standard certification)',
    name: manifest.name,
    version: manifest.version,
    skill: frontmatter[1],
    skillSha256: createHash('sha256').update(bytes).digest('hex'),
    componentCount: 1,
  };
}

if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
  const args = process.argv.slice(2);
  assert(args.length <= 2 && (!args[1] || args[1] === '--materialized'), 'Usage: node validate-plugin.mjs [directory [--materialized]]');
  console.log(JSON.stringify(validateWorkshopPlugin(args[0] ? resolve(args[0]) : templatePluginRoot, {
    templates: args[1] !== '--materialized',
  }), null, 2));
}
